<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:entry title="${%Rust Version}" field="toolchain" description="${%Standalone Rust release version to download and install}">
    <f:select />
  </f:entry>
  <f:entry title="${%Crates Mirror URL}" field="mirrorUrl" description="${%Optional corporate crates repository mirror URL}">
    <f:textbox />
  </f:entry>
  <f:entry title="${%Expected SHA-256 Checksum}" field="expectedSha256" description="${%Optional SHA-256 hash to strictly enforce integrity}">
    <f:textbox />
  </f:entry>
</j:jelly>
