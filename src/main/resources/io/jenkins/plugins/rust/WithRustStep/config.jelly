<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:entry title="${%Toolchain}" field="toolchain" description="${%e.g. 'stable', '1.85.0', 'nightly', or tool name}">
        <f:textbox default="stable" />
    </f:entry>
    <f:entry title="${%Components}" field="components" description="${%Comma-separated components, e.g. 'clippy,rustfmt'}">
        <f:textbox />
    </f:entry>
    <f:entry title="${%Targets}" field="targets" description="${%Comma-separated targets, e.g. 'wasm32-unknown-unknown'}">
        <f:textbox />
    </f:entry>
    <f:entry title="${%Crates mirror URL}" field="mirrorUrl" description="${%Optional crates mirror URL (e.g. Artifactory, Nexus)}">
        <f:textbox />
    </f:entry>
    <f:entry title="${%Isolate CARGO_HOME in workspace}" field="isolateCargoHome" description="${%Prevents global ~/.cargo lock contention on multi-executor agents}">
        <f:checkbox />
    </f:entry>
</j:jelly>
