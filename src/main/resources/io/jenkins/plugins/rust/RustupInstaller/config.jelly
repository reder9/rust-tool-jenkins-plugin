<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:entry title="${%Toolchain version or channel}" field="toolchain" description="${%e.g. 'stable', '1.85.0', 'nightly'}">
        <f:textbox default="stable" />
    </f:entry>
    <f:entry title="${%Components}" field="components" description="${%Comma-separated list of components, e.g. 'clippy,rustfmt'}">
        <f:textbox />
    </f:entry>
    <f:entry title="${%Targets}" field="targets" description="${%Comma-separated list of cross-compilation targets, e.g. 'wasm32-unknown-unknown'}">
        <f:textbox />
    </f:entry>
    <f:entry title="${%Crates.io mirror URL}" field="mirrorUrl" description="${%Optional corporate crates repository mirror (e.g. Artifactory, Nexus)}">
        <f:textbox />
    </f:entry>
</j:jelly>
